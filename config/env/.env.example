# llm-platform — قالب المتغيّرات (R-ARCH-42). انسخه إلى .env واملأ القيم.
# .env الحقيقي git-ignored ولا يُرفع أبداً (R-ARCH-02/20). لا قيم حقيقية هنا، ولا بادئة sk- (R-ARCH-20).
# بعد النسخ قيّد الصلاحيات — Linux: chmod 600 .env | Windows: icacls .env /inheritance:r /grant:r "%USERNAME%:F"
# ولّد الأسرار بأمان (لا تترك CHANGE_ME): openssl rand -hex 32

# ── المحرّك المحلي (Gemma 4 على GPU — ADR-011) ──
MODEL_DIR=../models-gemma4                         # مجلّد GGUF على المضيف (نسبةً لـ compose/ في جذر المستودع) أو مسار مطلق
MODEL_FILE=gemma-4-E2B-it-qat-UD-Q4_K_XL.gguf      # اسم ملف GGUF داخل MODEL_DIR
MMPROJ_FILE=mmproj-F16.gguf                         # مُسقِط الرؤية (multimodal projector) من نفس عائلة الموديل (ADR-014)
IMAGE_MAX_TOKENS=256                                # سقف توكنات الصورة الواحدة — يكبح ذروة VRAM على 6GB
LLAMACPP_API_KEY=local-dummy-key                   # مفتاح داخلي بين البوّابة والمحرّك (وهمي يكفي على شبكة Docker)
N_GPU_LAYERS=999                                   # كل الطبقات على الـ GPU
CTX_SIZE=4096                                      # نافذة السياق (آمنة مع الرؤية على 6GB، ADR-014). ارفعها لـ 8192 فقط إن أطفأت mmproj وراقبت VRAM

# ── محرّك التضمين (Qwen3-Embedding-0.6B على CPU — ADR-019) ──
EMBED_MODEL_DIR=../models-embeddings               # مجلّد GGUF للتضمين (نسبةً لـ compose/) أو مسار مطلق
EMBED_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf    # اسم ملف GGUF للتضمين
EMBED_CTX_SIZE=2048                                 # نافذة سياق التضمين (كافية لمقاطع الذاكرة)

# ── LiteLLM gateway ──
LITELLM_MASTER_KEY=CHANGE_ME_master               # مفتاح إدارة البوّابة
LITELLM_SALT_KEY=CHANGE_ME_salt                   # ⚠️ لا يُغيَّر بعد تخزين مفاتيح (R-ARCH-44)
OPENWEBUI_LITELLM_KEY=REPLACE_WITH_VIRTUAL_KEY    # virtual key من litellm /key/generate (لا تعِد استخدام master)
MEMORY_LITELLM_KEY=REPLACE_WITH_VIRTUAL_KEY       # virtual key لخدمة memory لطلب التضمين عبر البوّابة (ADR-023)؛ ولّده بـ /key/generate (scope: embed-default)

# ── Postgres (حالة LiteLLM) ──
POSTGRES_PASSWORD=CHANGE_ME_db_password

# ── Open WebUI ──
WEBUI_SECRET_KEY=CHANGE_ME_webui_secret
OPENWEBUI_PORT=3000
OPENWEBUI_BIND=127.0.0.1                           # واجهة الربط؛ للكشف العام استخدم reverse-proxy + TLS

# ── Context Engine: ميزانية حقن الذاكرة واعية بالنافذة (ADR-021) ──
CTX_MODEL_WINDOW=4096                              # نافذة الموديل الحالي (حدّثها عند تبديل الموديل)
CTX_RESERVED_TOKENS=2560                           # محجوز للجواب + الرسائل الحيّة (window-reserved = سقف الحقن)
CTX_INJECTION_BUDGET=1000                          # سقف حقن الذاكرة المرغوب (يُقصّ فعلياً بـ window-reserved)

# ── للتبديل لـ managed لاحقاً (سطر واحد في litellm-config.yaml) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
