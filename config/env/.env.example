# llm-platform — قالب المتغيّرات (R-ARCH-42). انسخه إلى .env واملأ القيم.
# .env الحقيقي git-ignored ولا يُرفع أبداً (R-ARCH-02/20). لا قيم حقيقية هنا، ولا بادئة sk- (R-ARCH-20).
# بعد النسخ قيّد الصلاحيات — Linux: chmod 600 .env | Windows: icacls .env /inheritance:r /grant:r "%USERNAME%:F"
# ولّد الأسرار بأمان (لا تترك CHANGE_ME): openssl rand -hex 32

# ── المحرّك المحلي (vLLM — ADR-028) ──
# الموديل ومعاملات الذاكرة/السياق في config/vllm/vllm-config.yaml (تبديل الموديل = تعديل سطرين هناك؛ لا تنزيل يدوي)
VLLM_API_KEY=CHANGE_ME_internal_engine_key         # مفتاح داخلي بين البوّابة والمحرّك (شبكة Docker فقط)
# HF_TOKEN=                                        # فقط لموديلات HuggingFace المقفلة (gated) — Qwen3-4B-AWQ غير مقفل
# VLLM_USE_V2_MODEL_RUNNER=1                       # على Linux أصلي/سحابة فقط؛ الافتراضي 0 (WSL2 بلا UVA — ADR-028)

# ── LiteLLM gateway ──
LITELLM_MASTER_KEY=CHANGE_ME_master               # مفتاح إدارة البوّابة
LITELLM_SALT_KEY=CHANGE_ME_salt                   # ⚠️ لا يُغيَّر بعد تخزين مفاتيح (R-ARCH-44)
OPENWEBUI_LITELLM_KEY=REPLACE_WITH_VIRTUAL_KEY    # virtual key من litellm /key/generate (لا تعِد استخدام master)

# ── Postgres (نسختان مخصّصتان — ADR-030؛ least-privilege — ADR-029) ──
LITELLM_DB_ADMIN_PASSWORD=CHANGE_ME_litellm_admin      # superuser نسخة postgres-litellm — للإدارة فقط، لا يتصل به تطبيق
LITELLM_DB_PASSWORD=CHANGE_ME_litellm_db_password      # دور litellm العادي (يملك قاعدته فقط)
OPENWEBUI_DB_ADMIN_PASSWORD=CHANGE_ME_owui_admin       # superuser نسخة postgres-openwebui — للإدارة فقط، لا يتصل به تطبيق
OPENWEBUI_DB_PASSWORD=CHANGE_ME_owui_db_password       # دور openwebui العادي (يملك قاعدته فقط — ميتاداتا + متجهات)
# للانتقال لـ Postgres خارجي/مُدار على سيرفر لاحقاً: بدّل host في الروابط داخل compose (مع sslmode) — تغيير رابط فقط (ADR-029/030)

# ── النسخ الاحتياطي (الموجة B — تشفير النسخ عبر openssl AES-256؛ إجراء يدوي موثّق في RUNBOOK) ──
BACKUP_PASSPHRASE=CHANGE_ME_backup_encryption_passphrase   # ⚠️ فقدانه = النسخ المشفّرة غير قابلة للاستعادة — احفظه بأمان خارج git (ولّده: openssl rand -hex 32)

# ── Open WebUI (تملك RAG + Memory المدمجة — ADR-025) ──
WEBUI_SECRET_KEY=CHANGE_ME_webui_secret
OPENWEBUI_PORT=3000
OPENWEBUI_BIND=127.0.0.1                           # واجهة الربط؛ للكشف العام استخدم reverse-proxy + TLS

# ── المراقبة (النوع الثاني: Prometheus + Grafana — ADR-031؛ profile: monitoring، لا تقلع افتراضياً) ──
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin    # كلمة سرّ أدمن Grafana (واجهة محلية على 127.0.0.1 فقط)
# GRAFANA_PORT=3001                               # منفذ Grafana المحلي (افتراضي 3001)
# GRAFANA_BIND=127.0.0.1                           # واجهة ربط Grafana؛ للكشف العام استخدم reverse-proxy + TLS

# ── اختيارية (لها افتراضات سليمة في compose — R-ARCH-42) ──
# WEBUI_NAME=Sankari Chat                          # اسم الواجهة المعروض (علامة، ليس الموديل — ADR-017)
# LITELLM_LOG=INFO                                 # مستوى سجل البوّابة (R-ERR-17)
# WEBUI_LOG_LEVEL=INFO                             # مستوى سجل الواجهة
# VLLM_LOG_LEVEL=INFO                              # مستوى سجل المحرّك

# ── للتبديل لـ managed لاحقاً (سطر في litellm-config.yaml + تمرير المتغيّر في بيئة litellm بالـ compose) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
